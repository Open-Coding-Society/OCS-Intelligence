# Admission gateway environment — deploy to /etc/ocs-gateway/gateway.env on EC2
UPSTREAM_URL=http://100.75.123.203:9000
PUBLIC_API_KEYS=CHANGE_ME_GENERATE_A_STUDENT_KEY
GROUP_A_MODEL_ALIAS=qwen3.8:27b
GROUP_B_MODEL_ALIAS=gemma4:26b
GROUP_A_INFLIGHT=1
GROUP_B_INFLIGHT=2
MAX_WAITERS_PER_WORKER=4
KEEPALIVE_INTERVAL_SECONDS=15
CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_TIMEOUT_SECONDS=3600
# Optional Rig 2 lane (decision 0012). Callers still use only a PUBLIC_API_KEYS key; the gateway
# sends RIG2_UPSTREAM_API_KEY to Rig 2 instead: Rig 2's existing Open WebUI key, one of
# PUBLIC_API_KEYS in Rig 2's /etc/ocs-orchestrator/orchestrator.env. Empty RIG2_MODEL_ALIAS = no lane.
RIG2_MODEL_ALIAS=qwen3.6:35b-a3b
RIG2_UPSTREAM_URL=http://100.75.127.192:9000
RIG2_UPSTREAM_API_KEY=CHANGE_ME_COPY_RIG2_OPEN_WEBUI_KEY
RIG2_INFLIGHT=2
