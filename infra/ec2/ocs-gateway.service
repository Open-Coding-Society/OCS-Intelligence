[Unit]
Description=OCS Intelligence EC2 admission gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ocs-gateway/gateway.env
WorkingDirectory=/opt/ocs-gateway
ExecStart=/opt/ocs-gateway/.venv/bin/python -m uvicorn gateway.main:app \
  --host 127.0.0.1 --port 9100 --workers 1 --proxy-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ocs-gateway
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
