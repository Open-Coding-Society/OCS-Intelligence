# Rig 2 worker: one model on every GPU (setup.sh writes qwen3.8:27b; Rig 2 now runs qwen3.6:35b-a3b). Deploy to /etc/ocs-intelligence/worker.env (mode 0600).
# setup.sh writes this file for you; the template shows what it contains.
CUDA_VISIBLE_DEVICES=CHANGE_ME_COMMA_SEPARATED_GPU_UUIDS_FROM_nvidia-smi_-L
DEFAULT_MODEL_GGUF=/srv/ocs-intelligence/models/qwen3.8-27b-q4_k_m.gguf
DEFAULT_MODEL_ID=qwen3.8:27b
CONTEXT_SIZE=262144
PARALLEL=1
TENSOR_SPLIT=1,1,1,1,1,1,1,1
WORKER_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY
# Extra llama-server flags, split on spaces (e.g. -ub 1024)
LLAMA_EXTRA_ARGS=
