# Local client credentials — copy to .env and fill in.
# .env is gitignored. Do not commit real keys.

OCS_BASE_URL=https://ai.opencodingsociety.com/v1
OCS_API_KEY=sk-your-student-key-here

# Operators only: NetBird personal access token, for managing peers, groups,
# and policies through https://api.netbird.io. Create one in the NetBird
# dashboard under Settings -> Personal Access Tokens.
NETBIRD_API_TOKEN=nbp_CHANGE_ME

# Mac minis (infra/macmini/ansible reads these; see docs/operations/set-up-mac-minis.md)
MACMINI_SUDO_PASSWORD=CHANGE_ME
MACMINI_WIFI_SSID=OCS_Intel
MACMINI_WIFI_PASSWORD=CHANGE_ME
# Reusable NetBird setup key that adds peers to ocs-macminis:
#   python3 infra/netbird/apply.py setup-key ocs-macminis
NETBIRD_MACMINI_SETUP_KEY=CHANGE_ME
